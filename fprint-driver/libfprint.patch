diff --git a/libfprint/meson.build b/libfprint/meson.build
index 093b932..3436f16 100644
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -139,6 +139,7 @@ driver_sources = {
     'focaltech_moc' : files('drivers/focaltech_moc/focaltech_moc.c'),
     'mafpmoc' : files('drivers/mafpmoc/mafpmoc.c'),
     'secugen' : files('drivers/secugen.c'),
+    'sil6250' : files('drivers/sil6250/sil6250.c'),
 }
 
 helper_sources = {
@@ -147,6 +148,7 @@ helper_sources = {
     'aes3k': files('drivers/aes3k.c'),
     'openssl': files(),
     'udev': files(),
+    'sil6250': files(),
     'virtual': files('drivers/virtual-device-listener.c'),
 }
 
diff --git a/meson.build b/meson.build
index 538415a..fd90a6e 100644
--- a/meson.build
+++ b/meson.build
@@ -148,6 +148,7 @@ default_drivers = [
     'focaltech_moc',
     'mafpmoc',
     'secugen',
+    'sil6250',
 ]
 
 spi_drivers = [
@@ -219,6 +220,7 @@ driver_helper_mapping = {
     'virtual_image'          : [ 'virtual' ],
     'virtual_device'         : [ 'virtual' ],
     'virtual_device_storage' : [ 'virtual' ],
+    'sil6250'                : [ 'sil6250' ],
 }
 
 driver_helpers = []
@@ -289,6 +291,18 @@ foreach i : driver_helpers
         libfprint_conf.set10('HAVE_UDEV', true)
 
         optional_deps += gudev_dep
+    elif i == 'sil6250'
+        # The SIL6250 driver is a thin FpDevice adapter over libsil6250, which
+        # owns the mailbox protocol, the TLS-PSK capture engine, and the host
+        # matcher. Build and install it from the standalone sil6250-linux repo
+        # (its lib/) before configuring libfprint; it is found via pkg-config.
+        sil6250_dep = dependency('libsil6250', version: '>= 0.1.0', required: false)
+        if not sil6250_dep.found()
+            error('libsil6250 (>= 0.1.0) is required for the sil6250 driver; ' +
+                  'build and install sil6250-linux/lib first')
+        endif
+
+        optional_deps += sil6250_dep
     endif
 endforeach
 
