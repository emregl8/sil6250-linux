+static void
+test_udev_resource_paths (void)
+{
+  g_autoptr(FpAutoResetClass) dev_class = auto_reset_device_class ();
+  g_autoptr(FpDevice) device = NULL;
+  g_autofree gchar *path = NULL;
+
+  dev_class->type = FP_DEVICE_TYPE_UDEV;
+  device = g_object_new (FPI_TYPE_DEVICE_FAKE,
+                         "fpi-udev-data-spidev", "/dev/spidev-test",
+                         "fpi-udev-data-hidraw", "/dev/hidraw-test",
+                         "fpi-udev-data-misc", "/dev/misc-test", NULL);
+  g_assert_cmpstr (fpi_device_get_udev_data (device, FPI_DEVICE_UDEV_SUBTYPE_SPIDEV),
+                   ==, "/dev/spidev-test");
+  g_assert_cmpstr (fpi_device_get_udev_data (device, FPI_DEVICE_UDEV_SUBTYPE_HIDRAW),
+                   ==, "/dev/hidraw-test");
+  g_assert_cmpstr (fpi_device_get_udev_data (device, FPI_DEVICE_UDEV_SUBTYPE_MISC),
+                   ==, "/dev/misc-test");
+  g_object_get (device, "fpi-udev-data-misc", &path, NULL);
+  g_assert_cmpstr (path, ==, "/dev/misc-test");
+}
+
 int
