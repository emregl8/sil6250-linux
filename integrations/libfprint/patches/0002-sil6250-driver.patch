+
 if udev_rules.disabled()
     install_udev_rules = false
 endif
diff --git a/tests/meson.build b/tests/meson.build
index d218e04d..3e8df9af 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -309,6 +309,19 @@ test_utils = static_library('fprint-test-utils',
