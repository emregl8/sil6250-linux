diff --git a/libfprint/drivers/sil6250.c b/libfprint/drivers/sil6250.c
new file mode 100644
index 0000000000000000000000000000000000000000..c975d5e6da5a83e92431b8d90448456b01c0fe4f
--- /dev/null
+++ b/libfprint/drivers/sil6250.c
@@ -0,0 +1,521 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#define FP_COMPONENT "sil6250"
+
+#include "drivers_api.h"
+#include <sil6250_ffi.h>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#define ENROLL_STAGES 15
+#define QUALITY_MIN 0.52f
+#define MATCH_THRESHOLD 5
+#define MAX_REDUNDANT (ENROLL_STAGES * 4)
+#define VERIFY_SCANS 3
+#define VERIFY_RETRY_SECONDS 8
+
+typedef struct _FpiDeviceSil6250
+{
+  FpDevice parent;
+} FpiDeviceSil6250;
+
+typedef struct _FpiDeviceSil6250Class
+{
+  FpDeviceClass parent_class;
+} FpiDeviceSil6250Class;
+
+GType fpi_device_sil6250_get_type (void);
+
+G_DEFINE_TYPE (FpiDeviceSil6250, fpi_device_sil6250, FP_TYPE_DEVICE)
+
+typedef enum
+{
+  OP_ENROLL,
+  OP_VERIFY,
+  OP_IDENTIFY,
+} OperationKind;
+
+typedef struct
+{
+  OperationKind kind;
+  gchar *path;
+  GBytes *gallery;
+  GPtrArray *galleries;
+  GPtrArray *prints;
+} Operation;
+
+typedef struct
+{
+  GByteArray *gallery;
+  gboolean matched;
+  gint match_index;
+} OperationResult;
+
+typedef struct
+{
+  FpDevice *device;
+  guint stage;
+} Progress;
+
+typedef struct
+{
+  FpDevice *device;
+  FpiDeviceAction action;
+  FpFingerStatusFlags added;
+  FpFingerStatusFlags removed;
+} FingerStatus;
+
+static void
+operation_free (gpointer data)
+{
+  Operation *op = data;
+  g_clear_pointer (&op->path, g_free);
+  g_clear_pointer (&op->gallery, g_bytes_unref);
+  g_clear_pointer (&op->galleries, g_ptr_array_unref);
+  g_clear_pointer (&op->prints, g_ptr_array_unref);
+  g_free (op);
+}
+
+static void
+operation_result_free (gpointer data)
+{
+  OperationResult *result = data;
+  if (result == NULL)
+    return;
+  g_clear_pointer (&result->gallery, g_byte_array_unref);
+  g_free (result);
+}
+
+static gboolean
+report_progress (gpointer data)
+{
+  Progress *progress = data;
+  FpDevice *device = progress->device;
+
+  if (fpi_device_get_current_action (device) == FPI_DEVICE_ACTION_ENROLL &&
+      !fpi_device_action_is_cancelled (device))
+    fpi_device_enroll_progress (device, progress->stage, NULL, NULL);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+progress_free (gpointer data)
+{
+  Progress *progress = data;
+  g_object_unref (progress->device);
+  g_free (progress);
+}
+
+static void
+queue_progress (GTask *task, guint stage)
+{
+  Progress *progress = g_new0 (Progress, 1);
+  progress->device = g_object_ref (g_task_get_source_object (task));
+  progress->stage = stage;
+  g_main_context_invoke_full (g_task_get_context (task), G_PRIORITY_DEFAULT,
+                              report_progress, progress, progress_free);
+}
+
+static gboolean
+report_finger_status (gpointer data)
+{
+  FingerStatus *status = data;
+  if (fpi_device_get_current_action (status->device) == status->action &&
+      !fpi_device_action_is_cancelled (status->device))
+    fpi_device_report_finger_status_changes (status->device,
+                                             status->added,
+                                             status->removed);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+finger_status_free (gpointer data)
+{
+  FingerStatus *status = data;
+  g_object_unref (status->device);
+  g_free (status);
+}
+
+static void
+queue_finger_status (GTask *task, FpiDeviceAction action,
+                     FpFingerStatusFlags added, FpFingerStatusFlags removed)
+{
+  FingerStatus *status = g_new0 (FingerStatus, 1);
+  status->device = g_object_ref (g_task_get_source_object (task));
+  status->action = action;
+  status->added = added;
+  status->removed = removed;
+  g_main_context_invoke_full (g_task_get_context (task), G_PRIORITY_DEFAULT,
+                              report_finger_status, status, finger_status_free);
+}
+
+static void
+scan_worker (GTask *task, gpointer source, gpointer task_data, GCancellable *cancellable)
+{
+  Operation *op = task_data;
+  Sil6250Engine *engine;
+  OperationResult *result;
+  g_autoptr(GByteArray) kept_frames = NULL;
+  guint accepted = 0;
+  guint redundant = 0;
+  guint scanned = 0;
+  gint64 deadline;
+  gint64 retry_deadline;
+
+  (void) source;
+  engine = sil6250_engine_new (op->path);
+  if (engine == NULL)
+    {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                               "Could not open SIL6250 sensor");
+      return;
+    }
+
+  result = g_new0 (OperationResult, 1);
+  result->match_index = -1;
+  if (op->kind == OP_ENROLL)
+    {
+      result->gallery = g_byte_array_new ();
+      kept_frames = g_byte_array_new ();
+    }
+  deadline = g_get_monotonic_time () +
+             (op->kind == OP_ENROLL ? 300 : 45) * G_USEC_PER_SEC;
+  retry_deadline = deadline;
+
+  while (!g_cancellable_is_cancelled (cancellable) &&
+         g_get_monotonic_time () < deadline &&
+         g_get_monotonic_time () < retry_deadline)
+    {
+      guint8 raw[SIL6250_IMAGE_SIZE];
+      gint captured = sil6250_engine_capture (engine, 1000, raw, sizeof raw);
+      gfloat quality;
+
+      if (captured < 0)
+        {
+          g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                                   "SIL6250 capture failed");
+          goto out;
+        }
+      if (captured == 0)
+        continue;
+      if (g_cancellable_is_cancelled (cancellable))
+        break;
+
+      quality = sil6250_frame_quality (raw, sizeof raw);
+      if (quality < QUALITY_MIN)
+        {
+          sil6250_engine_wait_lift (engine, 4000);
+          continue;
+        }
+
+      if (op->kind != OP_ENROLL)
+        {
+          FpiDeviceAction action = op->kind == OP_VERIFY ?
+                                   FPI_DEVICE_ACTION_VERIFY : FPI_DEVICE_ACTION_IDENTIFY;
+          queue_finger_status (task, action, FP_FINGER_STATUS_PRESENT,
+                               FP_FINGER_STATUS_NEEDED);
+          guint count = op->kind == OP_VERIFY ? 1 : op->galleries->len;
+          for (guint i = 0; i < count; i++)
+            {
+              GBytes *bytes = op->kind == OP_VERIFY ? op->gallery :
+                              g_ptr_array_index (op->galleries, i);
+              gsize gallery_len;
+              const guint8 *gallery = g_bytes_get_data (bytes, &gallery_len);
+              gint score = sil6250_frame_score (raw, sizeof raw, gallery,
+                                                gallery_len);
+              fp_dbg ("scan quality %.3f, gallery %u score %d", quality, i, score);
+              if (score < 0)
+                {
+                  g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                                           "Invalid SIL6250 enrollment data");
+                  goto out;
+                }
+              if (score >= MATCH_THRESHOLD)
+                {
+                  result->matched = TRUE;
+                  result->match_index = (gint) i;
+                  break;
+                }
+            }
+          if (result->matched || ++scanned == VERIFY_SCANS ||
+              !sil6250_engine_wait_lift (engine, 4000))
+            {
+              g_task_return_pointer (task, result, operation_result_free);
+              result = NULL;
+              goto out;
+            }
+          queue_finger_status (task, action, FP_FINGER_STATUS_NEEDED,
+                               FP_FINGER_STATUS_PRESENT);
+          retry_deadline = MIN (deadline, g_get_monotonic_time () +
+                                         VERIFY_RETRY_SECONDS * G_USEC_PER_SEC);
+          continue;
+        }
+
+      gboolean duplicate = FALSE;
+      for (guint i = 0; i < accepted; i++)
+        {
+          const guint8 *prior = kept_frames->data + i * SIL6250_IMAGE_SIZE;
+          if (sil6250_frame_ncc (raw, prior, sizeof raw) > 0.85f)
+            {
+              duplicate = TRUE;
+              break;
+            }
+        }
+      if (duplicate)
+        {
+          if (++redundant >= MAX_REDUNDANT)
+            break;
+        }
+      else
+        {
+          guint8 feature[SIL6250_MAX_FEATURE_SIZE];
+          ssize_t feature_len = sil6250_frame_extract (raw, sizeof raw,
+                                                        feature, sizeof feature);
+          if (feature_len <= 0)
+            {
+              g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                                       "Could not extract SIL6250 features");
+              goto out;
+            }
+          guint32 size_le = GUINT32_TO_LE ((guint32) feature_len);
+          g_byte_array_append (result->gallery, (guint8 *) &size_le, sizeof size_le);
+          g_byte_array_append (result->gallery, feature, (guint) feature_len);
+          g_byte_array_append (kept_frames, raw, sizeof raw);
+          queue_progress (task, ++accepted);
+          if (accepted == ENROLL_STAGES)
+            {
+              sil6250_engine_wait_lift (engine, 4000);
+              g_task_return_pointer (task, result, operation_result_free);
+              result = NULL;
+              goto out;
+            }
+        }
+      sil6250_engine_wait_lift (engine, 4000);
+    }
+
+  if (g_cancellable_is_cancelled (cancellable))
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED,
+                             "SIL6250 scan cancelled");
+  else if (scanned > 0)
+    {
+      g_task_return_pointer (task, result, operation_result_free);
+      result = NULL;
+    }
+  else
+    g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_TIMED_OUT,
+                             "SIL6250 scan timed out");
+
+out:
+  operation_result_free (result);
+  sil6250_engine_free (engine);
+}
+
+static void
+scan_done (GObject *source, GAsyncResult *async_result, gpointer user_data)
+{
+  FpDevice *device = FP_DEVICE (source);
+  GTask *task = G_TASK (async_result);
+  Operation *op = g_task_get_task_data (task);
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) data = NULL;
+  OperationResult *result = g_task_propagate_pointer (task, &error);
+
+  (void) user_data;
+  if (fpi_device_action_is_cancelled (device) && error == NULL)
+    error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED,
+                                 "SIL6250 scan cancelled");
+
+  if (op->kind == OP_ENROLL)
+    {
+      if (error == NULL)
+        {
+          FpPrint *print;
+          fpi_device_get_enroll_data (device, &print);
+          fpi_print_set_type (print, FPI_PRINT_RAW);
+          data = g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE,
+                                            result->gallery->data,
+                                            result->gallery->len, 1);
+          g_variant_ref_sink (data);
+          g_object_set (print, "fpi-data", data, NULL);
+          fpi_device_enroll_complete (device, g_object_ref (print), NULL);
+        }
+      else
+        fpi_device_enroll_complete (device, NULL, g_steal_pointer (&error));
+    }
+  else if (op->kind == OP_VERIFY)
+    {
+      if (error == NULL)
+        fpi_device_verify_report (device,
+                                  result->matched ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL,
+                                  NULL, NULL);
+      fpi_device_verify_complete (device, g_steal_pointer (&error));
+    }
+  else
+    {
+      if (error == NULL)
+        {
+          FpPrint *match = result->match_index < 0 ? NULL :
+                           g_ptr_array_index (op->prints, result->match_index);
+          fpi_device_identify_report (device, match, NULL, NULL);
+        }
+      fpi_device_identify_complete (device, g_steal_pointer (&error));
+    }
+
+  operation_result_free (result);
+}
+
+static void
+start_scan (FpDevice *device, OperationKind kind)
+{
+  Operation *op = g_new0 (Operation, 1);
+  GTask *task;
+  GPtrArray *prints = NULL;
+  op->kind = kind;
+  op->path = g_strdup (fpi_device_get_udev_data (device,
+                                                 FPI_DEVICE_UDEV_SUBTYPE_MISC));
+
+  if (kind != OP_ENROLL)
+    {
+      if (kind == OP_VERIFY)
+        {
+          FpPrint *print;
+          fpi_device_get_verify_data (device, &print);
+          prints = g_ptr_array_new ();
+          g_ptr_array_add (prints, print);
+        }
+      else
+        {
+          fpi_device_get_identify_data (device, &prints);
+          prints = g_ptr_array_ref (prints);
+        }
+      if (prints->len == 0)
+        {
+          g_ptr_array_unref (prints);
+          operation_free (op);
+          if (kind == OP_IDENTIFY)
+            {
+              fpi_device_identify_report (device, NULL, NULL, NULL);
+              fpi_device_identify_complete (device, NULL);
+            }
+          else
+            fpi_device_verify_complete (device,
+                                        fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID));
+          return;
+        }
+      op->galleries = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+      for (guint i = 0; i < prints->len; i++)
+        {
+          FpPrint *print = g_ptr_array_index (prints, i);
+          g_autoptr(GVariant) data = NULL;
+          gsize len = 0;
+          const guint8 *bytes;
+
+          g_object_get (print, "fpi-data", &data, NULL);
+          if (data == NULL || !g_variant_is_of_type (data, G_VARIANT_TYPE ("ay")))
+            goto invalid_data;
+          bytes = g_variant_get_fixed_array (data, &len, 1);
+          if (len == 0 || len > 2 * 1024 * 1024 ||
+              !sil6250_gallery_valid (bytes, len))
+            goto invalid_data;
+          g_ptr_array_add (op->galleries, g_bytes_new (bytes, len));
+        }
+      if (kind == OP_VERIFY)
+        {
+          op->gallery = g_bytes_ref (g_ptr_array_index (op->galleries, 0));
+          g_ptr_array_unref (prints);
+        }
+      else
+        op->prints = prints;
+    }
+
+  task = g_task_new (device, fpi_device_get_cancellable (device), scan_done, NULL);
+  g_task_set_check_cancellable (task, FALSE);
+  g_task_set_task_data (task, op, operation_free);
+  fpi_device_report_finger_status_changes (device, FP_FINGER_STATUS_NEEDED,
+                                           FP_FINGER_STATUS_NONE);
+  g_task_run_in_thread (task, scan_worker);
+  g_object_unref (task);
+  return;
+
+invalid_data:
+  g_ptr_array_unref (prints);
+  operation_free (op);
+  if (kind == OP_VERIFY)
+    fpi_device_verify_complete (device,
+                                fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID));
+  else
+    fpi_device_identify_complete (device,
+                                  fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID));
+}
+
+static void
+dev_open (FpDevice *device)
+{
+  const gchar *path = fpi_device_get_udev_data (device,
+                                                FPI_DEVICE_UDEV_SUBTYPE_MISC);
+  int fd = path ? open (path, O_RDWR | O_CLOEXEC) : -1;
+  if (fd < 0)
+    fpi_device_open_complete (device,
+                              fpi_device_error_new (FP_DEVICE_ERROR_GENERAL));
+  else
+    {
+      close (fd);
+      fpi_device_open_complete (device, NULL);
+    }
+}
+
+static void
+dev_close (FpDevice *device)
+{
+  fpi_device_close_complete (device, NULL);
+}
+
+static void
+dev_enroll (FpDevice *device)
+{
+  start_scan (device, OP_ENROLL);
+}
+
+static void
+dev_verify (FpDevice *device)
+{
+  start_scan (device, OP_VERIFY);
+}
+
+static void
+dev_identify (FpDevice *device)
+{
+  start_scan (device, OP_IDENTIFY);
+}
+
+static const FpIdEntry driver_ids[] = {
+  { .udev_types = FPI_DEVICE_UDEV_SUBTYPE_MISC,
+    .misc_name = "sil6250",
+    .misc_acpi_id = "SIL6250" },
+  { .udev_types = 0 },
+};
+
+static void
+fpi_device_sil6250_init (FpiDeviceSil6250 *self)
+{
+  (void) self;
+}
+
+static void
+fpi_device_sil6250_class_init (FpiDeviceSil6250Class *klass)
+{
+  FpDeviceClass *device_class = FP_DEVICE_CLASS (klass);
+  device_class->id = FP_COMPONENT;
+  device_class->full_name = "Silead SIL6250 Fingerprint Sensor";
+  device_class->type = FP_DEVICE_TYPE_UDEV;
+  device_class->id_table = driver_ids;
+  device_class->scan_type = FP_SCAN_TYPE_PRESS;
+  device_class->nr_enroll_stages = ENROLL_STAGES;
+  device_class->open = dev_open;
+  device_class->close = dev_close;
+  device_class->enroll = dev_enroll;
+  device_class->verify = dev_verify;
+  device_class->identify = dev_identify;
+  fpi_device_class_auto_initialize_features (device_class);
+}
