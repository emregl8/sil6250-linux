 unit_tests = [
     'fpi-device',
     'fpi-ssm',
diff --git a/tests/test-sil6250.c b/tests/test-sil6250.c
new file mode 100644
index 00000000..34f565f3
--- /dev/null
+++ b/tests/test-sil6250.c
@@ -0,0 +1,563 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "drivers_api.h"
+#include <sil6250_ffi.h>
+#include <string.h>
+#include <math.h>
+
+GType fpi_device_sil6250_get_type (void);
+
+struct Sil6250Engine
+{
+  guint unused;
+};
+
+static struct
+{
+  gint opened;
+  gint freed;
+  gint captures;
+  gint preparations;
+  gint extractions;
+  gint galleries_freed;
+  gint probes_freed;
+  gint lifts;
+  gint scores[4];
+  gfloat qualities[4];
+  gboolean open_error;
+  gboolean capture_error;
+  gboolean no_frame;
+  gboolean lift_error;
+  gboolean cancel_score;
+  Sil6250Cancelled cancelled;
+  void *cancel_data;
+  gboolean wait_control;
+  gboolean cancel_extract;
+  guint match_gallery;
+  GCancellable *cancellable;
+} mock;
+
+struct Sil6250Gallery { guint8 bytes[8]; };
+struct Sil6250Probe { guint8 raw[SIL6250_IMAGE_SIZE]; };
+
+static Sil6250Engine engine;
+
+Sil6250Engine *
+sil6250_engine_new (const char *path)
+{
+  g_assert_cmpstr (path, ==, "/dev/null");
+  g_atomic_int_inc (&mock.opened);
+  return mock.open_error ? NULL : &engine;
+}
+
+bool
+sil6250_engine_set_control (Sil6250Engine *handle, uint32_t timeout_ms,
+                            Sil6250Cancelled cancelled, void *user_data)
+{
+  g_assert_true (handle == &engine);
+  g_assert_cmpuint (timeout_ms, >, 0);
+  g_assert_cmpuint (timeout_ms, <=, 300000);
+  g_assert_nonnull (cancelled);
+  g_assert_true (G_IS_CANCELLABLE (user_data));
+  mock.cancelled = cancelled;
+  mock.cancel_data = user_data;
+  return true;
+}
+
+void
+sil6250_engine_free (Sil6250Engine *handle)
+{
+  g_assert_true (handle == &engine);
+  g_atomic_int_inc (&mock.freed);
+}
+
+int32_t
+sil6250_engine_capture (Sil6250Engine *handle, uint32_t timeout_ms,
+                       uint8_t *raw, size_t raw_len)
+{
+  gint index = g_atomic_int_add (&mock.captures, 1);
+  (void) timeout_ms;
+  g_assert_true (handle == &engine);
+  g_assert_cmpuint (raw_len, ==, SIL6250_IMAGE_SIZE);
+  if (mock.wait_control)
+    {
+      while (!mock.cancelled (mock.cancel_data))
+        g_usleep (1000);
+      return -1;
+    }
+  if (mock.capture_error)
+    return -1;
+  if (mock.no_frame)
+    {
+      g_usleep (1000);
+      return 0;
+    }
+  memset (raw, MIN (index, 3), raw_len);
+  return 1;
+}
+
+bool
+sil6250_engine_wait_lift (Sil6250Engine *handle, uint32_t timeout_ms)
+{
+  (void) timeout_ms;
+  g_assert_true (handle == &engine);
+  g_atomic_int_inc (&mock.lifts);
+  return !mock.lift_error;
+}
+
+float
+sil6250_frame_quality (const uint8_t *raw, size_t raw_len)
+{
+  g_assert_cmpuint (raw_len, ==, SIL6250_IMAGE_SIZE);
+  return mock.qualities[raw[0]];
+}
+
+float
+sil6250_frame_ncc (const uint8_t *raw, const uint8_t *reference, size_t raw_len)
+{
+  (void) raw;
+  (void) reference;
+  (void) raw_len;
+  return 0.0f;
+}
+
+ssize_t
+sil6250_frame_extract (const uint8_t *raw, size_t raw_len,
+                      uint8_t *output, size_t capacity)
+{
+  (void) raw;
+  (void) raw_len;
+  g_assert_cmpuint (capacity, >=, 4);
+  memcpy (output, "TEST", 4);
+  if (mock.cancel_extract)
+    g_cancellable_cancel (mock.cancellable);
+  return 4;
+}
+
+bool
+sil6250_gallery_valid (const uint8_t *gallery, size_t gallery_len)
+{
+  return gallery_len == 8 && gallery[0] == 4;
+}
+
+int32_t
+sil6250_frame_score (const uint8_t *raw, size_t raw_len,
+                    const uint8_t *gallery, size_t gallery_len)
+{
+  g_assert_cmpuint (raw_len, ==, SIL6250_IMAGE_SIZE);
+  g_assert_true (sil6250_gallery_valid (gallery, gallery_len));
+  if (mock.cancel_score)
+    g_cancellable_cancel (mock.cancellable);
+  if (mock.match_gallery && gallery[7] != mock.match_gallery)
+    return 0;
+  return mock.scores[raw[0]];
+}
+
+int32_t
+sil6250_frame_matches (const uint8_t *raw, size_t raw_len,
+                      const uint8_t *gallery, size_t gallery_len,
+                      int32_t threshold)
+{
+  gint score = sil6250_frame_score (raw, raw_len, gallery, gallery_len);
+  g_assert_cmpint (threshold, ==, 5);
+  return score < 0 ? -1 : score >= threshold;
+}
+
+Sil6250Gallery *
+sil6250_gallery_new (const uint8_t *bytes, size_t len)
+{
+  if (!sil6250_gallery_valid (bytes, len))
+    return NULL;
+  Sil6250Gallery *gallery = g_new0 (Sil6250Gallery, 1);
+  memcpy (gallery->bytes, bytes, len);
+  g_atomic_int_inc (&mock.preparations);
+  return gallery;
+}
+
+void
+sil6250_gallery_free (Sil6250Gallery *gallery)
+{
+  g_atomic_int_inc (&mock.galleries_freed);
+  g_free (gallery);
+}
+
+Sil6250Probe *
+sil6250_probe_new (const uint8_t *raw, size_t len)
+{
+  g_assert_cmpuint (len, ==, SIL6250_IMAGE_SIZE);
+  Sil6250Probe *probe = g_new0 (Sil6250Probe, 1);
+  memcpy (probe->raw, raw, len);
+  g_atomic_int_inc (&mock.extractions);
+  return probe;
+}
+
+void
+sil6250_probe_free (Sil6250Probe *probe)
+{
+  g_atomic_int_inc (&mock.probes_freed);
+  g_free (probe);
+}
+
+int32_t
+sil6250_probe_matches (const Sil6250Probe *probe, const Sil6250Gallery *gallery, int32_t threshold)
+{
+  return sil6250_frame_matches (probe->raw, sizeof probe->raw,
+                                gallery->bytes, sizeof gallery->bytes, threshold);
+}
+
+typedef struct
+{
+  FpDevice *device;
+  FpPrint *print;
+  GCancellable *cancellable;
+} Fixture;
+
+static FpPrint *
+make_print (FpDevice *device, guint8 marker)
+{
+  const guint8 bytes[] = { 4, 0, 0, 0, 'T', 'E', 'S', marker };
+  g_autoptr(GVariant) data = g_variant_ref_sink (
+    g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, bytes, sizeof bytes, 1));
+  FpPrint *print = g_object_ref_sink (fp_print_new (device));
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  g_object_set (print, "fpi-data", data, NULL);
+  return print;
+}
+
+static void
+setup (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  (void) data;
+  memset (&mock, 0, sizeof mock);
+  for (guint i = 0; i < G_N_ELEMENTS (mock.scores); i++)
+    {
+      mock.scores[i] = 5;
+      mock.qualities[i] = 0.8f;
+    }
+  fixture->device = g_object_new (fpi_device_sil6250_get_type (),
+                                  "fpi-udev-data-misc", "/dev/null", NULL);
+  fixture->print = make_print (fixture->device, 1);
+  fixture->cancellable = g_cancellable_new ();
+  mock.cancellable = fixture->cancellable;
+  g_assert_true (fp_device_open_sync (fixture->device, NULL, &error));
+  g_assert_no_error (error);
+}
+
+static void
+teardown (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  (void) data;
+  g_assert_true (fp_device_close_sync (fixture->device, NULL, &error));
+  g_assert_no_error (error);
+  g_clear_object (&fixture->print);
+  g_clear_object (&fixture->device);
+  g_clear_object (&fixture->cancellable);
+  g_assert_cmpint (mock.preparations, ==, mock.galleries_freed);
+  g_assert_cmpint (mock.extractions, ==, mock.probes_freed);
+}
+
+static gboolean
+verify (Fixture *fixture, gboolean *match, GError **error)
+{
+  return fp_device_verify_sync (fixture->device, fixture->print,
+                                fixture->cancellable, NULL, NULL, match, NULL, error);
+}
+
+static void
+test_verify_match (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = FALSE;
+  (void) data;
+  g_assert_true (verify (fixture, &match, &error));
+  g_assert_no_error (error);
+  g_assert_true (match);
+  g_assert_cmpint (mock.captures, ==, 1);
+  g_assert_cmpint (mock.freed, ==, 1);
+}
+
+static void
+test_verify_retries (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = FALSE;
+  (void) data;
+  mock.scores[0] = 0;
+  g_assert_true (verify (fixture, &match, &error));
+  g_assert_no_error (error);
+  g_assert_true (match);
+  g_assert_cmpint (mock.captures, ==, 2);
+  g_assert_cmpint (mock.lifts, ==, 1);
+}
+
+static void
+test_verify_rejects (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = TRUE;
+  (void) data;
+  memset (mock.scores, 0, sizeof mock.scores);
+  g_assert_true (verify (fixture, &match, &error));
+  g_assert_no_error (error);
+  g_assert_false (match);
+  g_assert_cmpint (mock.captures, ==, 3);
+  g_assert_cmpint (mock.lifts, ==, 2);
+}
+
+static void
+test_lift_timeout (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = TRUE;
+  (void) data;
+  mock.scores[0] = 0;
+  mock.lift_error = TRUE;
+  g_assert_true (verify (fixture, &match, &error));
+  g_assert_no_error (error);
+  g_assert_false (match);
+  g_assert_cmpint (mock.captures, ==, 1);
+}
+
+static void
+test_low_quality_retry (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = FALSE;
+  (void) data;
+  mock.qualities[0] = 0.1f;
+  g_assert_true (verify (fixture, &match, &error));
+  g_assert_no_error (error);
+  g_assert_true (match);
+  g_assert_cmpint (mock.captures, ==, 2);
+}
+
+static void
+test_invalid_quality (Fixture *fixture, gconstpointer data)
+{
+  const gfloat qualities[] = { NAN, INFINITY, -1.0f, 1.1f };
+  (void) data;
+  for (guint i = 0; i < G_N_ELEMENTS (qualities); i++)
+    {
+      g_autoptr(GError) error = NULL;
+      gboolean match = FALSE;
+      for (guint j = 0; j < G_N_ELEMENTS (mock.qualities); j++)
+        mock.qualities[j] = qualities[i];
+      g_assert_false (verify (fixture, &match, &error));
+      g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+      g_assert_false (match);
+      g_assert_cmpint (mock.freed, ==, i + 1);
+    }
+}
+
+static void
+test_matching_error (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = FALSE;
+  (void) data;
+  mock.scores[0] = -1;
+  g_assert_false (verify (fixture, &match, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_assert_false (match);
+  g_assert_cmpint (mock.freed, ==, 1);
+}
+
+static void
+test_invalid_gallery (Fixture *fixture, gconstpointer data)
+{
+  const guint8 bytes[] = { 0 };
+  g_autofree guint8 *oversized = g_malloc0 (2 * 1024 * 1024 + 1);
+  GVariant *values[] = {
+    g_variant_new_string ("invalid"),
+    g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, NULL, 0, 1),
+    g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, bytes, sizeof bytes, 1),
+    g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, oversized, 2 * 1024 * 1024 + 1, 1),
+  };
+  (void) data;
+  for (guint i = 0; i < G_N_ELEMENTS (values); i++)
+    {
+      g_autoptr(GVariant) value = g_variant_ref_sink (values[i]);
+      g_autoptr(GError) error = NULL;
+      gboolean match = TRUE;
+      g_object_set (fixture->print, "fpi-data", value, NULL);
+      g_assert_false (verify (fixture, &match, &error));
+      g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID);
+      g_assert_cmpint (mock.opened, ==, 0);
+    }
+}
+
+static void
+test_engine_open_error (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = TRUE;
+  (void) data;
+  mock.open_error = TRUE;
+  g_assert_false (verify (fixture, &match, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_FAILED);
+  g_assert_cmpint (mock.opened, ==, 1);
+  g_assert_cmpint (mock.freed, ==, 0);
+}
+
+static void
+test_capture_error_recovery (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = TRUE;
+  (void) data;
+  mock.capture_error = TRUE;
+  g_assert_false (verify (fixture, &match, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_FAILED);
+  g_assert_cmpint (mock.freed, ==, 1);
+  g_clear_error (&error);
+  mock.capture_error = FALSE;
+  g_assert_true (verify (fixture, &match, &error));
+  g_assert_no_error (error);
+  g_assert_true (match);
+  g_assert_cmpint (mock.freed, ==, 2);
+}
+
+static void
+test_cancelled_match (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = FALSE;
+  (void) data;
+  mock.cancel_score = TRUE;
+  g_assert_false (verify (fixture, &match, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  g_assert_false (match);
+  g_assert_cmpint (mock.freed, ==, 1);
+}
+
+static gboolean
+cancel_scan (gpointer cancellable)
+{
+  g_cancellable_cancel (cancellable);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+test_cancel_waiting (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = FALSE;
+  (void) data;
+  mock.no_frame = TRUE;
+  g_timeout_add (20, cancel_scan, fixture->cancellable);
+  g_assert_false (verify (fixture, &match, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  g_assert_false (match);
+  g_assert_cmpint (mock.freed, ==, 1);
+}
+
+static void
+test_cancel_capture (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  gboolean match = FALSE;
+  gint64 start = g_get_monotonic_time ();
+  (void) data;
+  mock.wait_control = TRUE;
+  g_timeout_add (20, cancel_scan, fixture->cancellable);
+  g_assert_false (verify (fixture, &match, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  g_assert_false (match);
+  g_assert_cmpint (g_get_monotonic_time () - start, <, G_USEC_PER_SEC);
+  g_assert_cmpint (mock.freed, ==, 1);
+}
+
+static void
+test_empty_identify (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GPtrArray) prints = g_ptr_array_new ();
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpPrint) match = NULL;
+  (void) data;
+  g_assert_true (fp_device_identify_sync (fixture->device, prints, NULL,
+                                          NULL, NULL, &match, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_null (match);
+  g_assert_cmpint (mock.opened, ==, 0);
+}
+
+static void
+test_identify_gallery_index (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(GPtrArray) prints = g_ptr_array_new ();
+  g_autoptr(FpPrint) second = make_print (fixture->device, 2);
+  g_autoptr(FpPrint) match = NULL;
+  g_autoptr(GError) error = NULL;
+  (void) data;
+  mock.match_gallery = 2;
+  g_ptr_array_add (prints, fixture->print);
+  g_ptr_array_add (prints, second);
+  g_assert_true (fp_device_identify_sync (fixture->device, prints, NULL,
+                                          NULL, NULL, &match, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_true (match == second);
+  g_assert_cmpint (mock.extractions, ==, 1);
+  g_assert_cmpint (mock.preparations, ==, 2);
+}
+
+static void
+test_enroll (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(FpPrint) template = g_object_ref_sink (fp_print_new (fixture->device));
+  g_autoptr(FpPrint) print = NULL;
+  g_autoptr(GVariant) gallery = NULL;
+  g_autoptr(GError) error = NULL;
+  (void) data;
+  print = fp_device_enroll_sync (fixture->device, template, NULL,
+                                 NULL, NULL, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (print);
+  g_object_get (print, "fpi-data", &gallery, NULL);
+  g_assert_cmpuint (g_variant_get_size (gallery), ==, 15 * 8);
+  g_assert_cmpint (mock.captures, ==, 15);
+  g_assert_cmpint (mock.freed, ==, 1);
+}
+
+static void
+test_cancel_enroll (Fixture *fixture, gconstpointer data)
+{
+  g_autoptr(FpPrint) template = g_object_ref_sink (fp_print_new (fixture->device));
+  g_autoptr(FpPrint) print = NULL;
+  g_autoptr(GError) error = NULL;
+  (void) data;
+  mock.cancel_extract = TRUE;
+  print = fp_device_enroll_sync (fixture->device, template, fixture->cancellable,
+                                 NULL, NULL, &error);
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  g_assert_null (print);
+  g_assert_cmpint (mock.freed, ==, 1);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+#define ADD_TEST(name, function) \
+  g_test_add ("/sil6250/" name, Fixture, NULL, setup, function, teardown)
+  ADD_TEST ("verify/match", test_verify_match);
+  ADD_TEST ("verify/retry", test_verify_retries);
+  ADD_TEST ("verify/reject", test_verify_rejects);
+  ADD_TEST ("verify/lift-timeout", test_lift_timeout);
+  ADD_TEST ("verify/low-quality", test_low_quality_retry);
+  ADD_TEST ("verify/invalid-gallery", test_invalid_gallery);
+  ADD_TEST ("verify/invalid-quality", test_invalid_quality);
+  ADD_TEST ("verify/matching-error", test_matching_error);
+  ADD_TEST ("verify/open-error", test_engine_open_error);
+  ADD_TEST ("verify/error-recovery", test_capture_error_recovery);
+  ADD_TEST ("verify/cancel-match", test_cancelled_match);
+  ADD_TEST ("verify/cancel-waiting", test_cancel_waiting);
+  ADD_TEST ("verify/cancel-capture", test_cancel_capture);
+  ADD_TEST ("identify/empty", test_empty_identify);
+  ADD_TEST ("identify/gallery-index", test_identify_gallery_index);
+  ADD_TEST ("enroll/complete", test_enroll);
+  ADD_TEST ("enroll/cancel", test_cancel_enroll);
+#undef ADD_TEST
+  return g_test_run ();
+}
