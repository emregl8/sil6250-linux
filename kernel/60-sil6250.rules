# Grant the active local session read/write access to the SIL6250 mailbox
# broker (/dev/sil6250) without sudo.
#
# TAG+="uaccess" makes systemd-logind add an ACL for the logged-in user.  This
# rule is numbered 60- (before 73-seat-late.rules, which applies the uaccess
# ACL) so the tag is set in time; a 0660 root:users fallback covers non-logind
# setups and system services such as fprintd.
#
# Install:
#   sudo cp 60-sil6250.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger -s misc        # or replug / reload the module

SUBSYSTEM=="misc", KERNEL=="sil6250", TAG+="uaccess", MODE="0660", GROUP="users"
